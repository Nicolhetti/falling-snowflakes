{
  "name": "@nicolhetti/falling-snowflakes",
  "version": "0.1.0",
  "description": "A lightweight, dependency-free canvas animation of falling snowflakes. Works with vanilla JS and React.",
  "keywords": [
    "snow",
    "snowflakes",
    "winter",
    "falling",
    "animation",
    "canvas",
    "snowfall",
    "react",
    "particles",
    "seasonal"
  ],
  "license": "MIT",
  "author": "Nicolhetti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nicolhetti/falling-snowflakes.git"
  },
  "homepage": "https://nicolhetti.github.io/falling-snowflakes/",
  "bugs": {
    "url": "https://github.com/Nicolhetti/falling-snowflakes/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "npm run build && npx --yes serve . -l 3000",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
